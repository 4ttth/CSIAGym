SECRET_KEY=
DATABASE_URL=
FLASK_ENV=production
CHALLENGE_HOST=
NC_CHALLENGE_HOST=
WEB_CHALLENGE_HOST=

# Auto-generated — do not share. Authenticates the main app → runner sidecar.
RUNNER_SECRET=
RUNNER_URL=http://runner:32526

# Absolute path on the HOST (not inside any container) where instance data lives.
# Linux/production:  HOST_INSTANCE_DIR=/opt/ctf/instance
# WSL2/Windows:      HOST_INSTANCE_DIR=/mnt/host/c/Users/CSIA-GYM/ctf-platform/instance
HOST_INSTANCE_DIR=/opt/ctf/instance

# ── Seeded challenge set ──────────────────────────────────────────────────────
# The official ten challenges are built from source and published on first boot.
# Set to 0 to skip seeding entirely.
SEED_CHALLENGES=1

# Optional: pin a flag instead of letting the seeder mint one. The name is the
# challenge slug, upper-cased, hyphens replaced with underscores. Only affects
# the first boot (after that the value in instance/seed_flags.json wins).
# SEED_FLAG_ROTTEN_BASE=CSIA{...}
